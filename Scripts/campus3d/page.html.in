<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f6f3ea"><title>栖灵 · 粤海校园</title>
<style>
:root{color-scheme:light;--ink:#263d35;--quiet:#56695f;--rule:#cbd2c3;--paper:#f8f6ef;--pine:#285c4e;--rust:#914824}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,"PingFang SC","Microsoft YaHei",sans-serif}main{max-width:1080px;margin:auto}header,.tools,.row,.options{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}header{padding:14px clamp(16px,4vw,36px);justify-content:space-between}h1,h2,h3,p{margin:0}h1{font-size:clamp(20px,3vw,27px);line-height:1.25;font-weight:700}h2{font-size:22px}h3{font-size:16px}small,.sub{color:var(--quiet);font-size:14px}.area{font-size:13px;color:var(--pine);letter-spacing:.12em}
button,select,input{font:inherit}button,select{min-height:42px;border:1px solid var(--rule);background:#fffdf6;color:var(--ink);border-radius:9px;padding:6px 12px;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #d07e37;outline-offset:2px}button:disabled{color:#667069;background:#ebede6;cursor:default}button.primary{background:var(--pine);border-color:var(--pine);color:white;font-weight:650}button.primary:disabled{background:#e4e8dd;border-color:var(--rule);color:#626f61}
#stage{height:clamp(345px,54svh,630px);position:relative;overflow:hidden;isolation:isolate;background:radial-gradient(ellipse at 52% 32%,#f6f0dc,#e9e5d4 65%,#dadcca);border-block:1px solid #d1d3c4}canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none}.place-label{position:absolute;transform:translate(-50%,-112%);min-height:28px;line-height:1.2;white-space:nowrap;color:#fff;background:#294b43ed;border:1px solid #fff9;font-size:12px;padding:5px 9px;border-radius:6px}.map-tools{position:absolute;top:10px;right:12px;display:flex;gap:6px}.map-tools button{min-height:36px;background:#fffcf0f0;font-size:13px}.hint{position:absolute;bottom:10px;left:14px;pointer-events:none;color:#3e5348;font-size:12px;background:#faf7ebdb;border-radius:6px;padding:3px 7px}#loading{position:absolute;top:48%;left:50%;transform:translate(-50%,-50%);background:var(--paper);padding:8px 12px;border-radius:6px;text-align:center}
.panel{padding:16px clamp(16px,4vw,36px) 34px;display:grid;gap:14px}.row{justify-content:space-between}.score{border-radius:18px;background:#e4ecde;padding:3px 10px;color:#355942;font-size:14px;font-weight:650}.options{gap:6px}.options button[aria-pressed=true]{border-color:var(--pine);color:var(--pine);background:#e6eee0;font-weight:700}.line{border-top:1px solid var(--rule);padding-top:12px}.stack{display:grid;gap:8px}input{background:#fffdf7;color:var(--ink);border:1px solid var(--rule);border-radius:8px;padding:9px 12px;width:100%}fieldset{border:0;padding:0;margin:0;min-width:0}#status{color:var(--rust);font-weight:600;min-height:0}#status:empty{display:none}summary{cursor:pointer;font-weight:600}details[open]>summary{margin-bottom:8px}#yesterday{background:#f1ecdf;border-radius:10px;padding:12px}#day{font-variant-numeric:tabular-nums}.choices{display:flex;gap:6px;flex-wrap:wrap}a{color:var(--pine)}@media(max-width:440px){header{padding:11px 14px}.panel{padding:12px 14px 30px;gap:10px}.options button{flex:1;padding:5px 3px;font-size:14px}.row{gap:4px}h2{font-size:20px}}
.study-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px}.study-grid figure,#study figure{margin:0}#study img{display:block;width:100%;height:auto;background:#e2e5df}#study figcaption{font-size:13px;color:var(--quiet);margin:4px 0 9px}#study>p{margin:5px 0 12px}#study{scroll-margin-top:10px}
.night{position:relative;isolation:isolate;overflow:hidden;background:#272b26 url('data:image/webp;base64,@@corridor-front@@') center/cover no-repeat;height:clamp(375px,65svh,710px);color:#f7f5e9}.night-view{position:absolute;inset:0;overflow:hidden;touch-action:none;cursor:grab;perspective-origin:50% 50%}.night-view:active{cursor:grabbing}.night-cube{position:absolute;top:50%;left:50%;transform-style:preserve-3d;visibility:hidden}.night-face{position:absolute;width:1024px;height:1024px;left:-512px;top:-512px;backface-visibility:hidden;background-image:var(--atlas);background-size:300% 200%;background-repeat:no-repeat}.night-tools,.night-foot{position:absolute;z-index:2;display:flex;align-items:center;gap:8px}.night-tools{right:12px;top:12px}.night button,#walk-in{font-size:13px}.night button{min-height:40px;background:#19221edb;color:#fffdf1;border:1px solid #d1d5bd66;padding:6px 12px;border-radius:7px}.night button:disabled{background:#222a25af;color:#abaea0;border-color:#c0c4ab33}.night-foot{bottom:0;left:0;right:0;padding:32px 14px 13px;background:linear-gradient(transparent,#111913d9);pointer-events:none;justify-content:space-between}.night-foot button{pointer-events:auto}.night-stop{font-size:15px;font-weight:600}.night-hint{font-size:12px;color:#d6d6c9}.night-steps{display:flex;gap:6px}.night::after{content:'';position:absolute;inset:0;background:#10170f;opacity:0;pointer-events:none;transition:opacity .18s ease}.night.moving::after{opacity:.38}@media(prefers-reduced-motion:reduce){.night::after{transition:none}}@media(max-width:440px){.night{height:clamp(395px,64svh,610px)}.map-tools{flex-wrap:wrap;justify-content:flex-end}}
</style>
<style>
.exterior{--folio-paper:#f8f6f0;--folio-ink:#20372e;--folio-rule:#bec4b8;--gutter:clamp(16px,4.5vw,80px);color:var(--folio-ink);background:var(--folio-paper)}
main:has(.exterior:not([hidden])){max-width:none}
.exterior~.panel{max-width:1080px;margin-inline:auto}
.folio-head,.folio-controls{padding-inline:max(var(--gutter),env(safe-area-inset-left)) max(var(--gutter),env(safe-area-inset-right))}
.folio-head{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:64px}
.folio-id{display:flex;align-items:center;gap:clamp(8px,1.2vw,16px)}
.folio-mark{width:24px;height:23px;background:linear-gradient(currentColor,currentColor) 0 0/24px 3px no-repeat,linear-gradient(currentColor,currentColor) 2px 7px/3px 16px no-repeat,linear-gradient(currentColor,currentColor) 10px 7px/3px 16px no-repeat,linear-gradient(currentColor,currentColor) 18px 7px/3px 16px no-repeat}
.folio-brand,.folio-title{font-family:"STSong","Songti SC","Noto Serif CJK SC","SimSun",serif;font-weight:600}
.folio-brand{font-size:23px;line-height:1}.folio-context{border-left:1px solid var(--folio-rule);padding-left:clamp(9px,1.2vw,16px);font-size:13px;letter-spacing:.1em}
.exterior a,.scene-header a{text-decoration:none;color:inherit}.exterior a:focus-visible,.scene-header a:focus-visible,.night-tools a:focus-visible{outline:3px solid #c8752b;outline-offset:3px}
.folio-jump,.scene-links a{font-size:14px;min-height:44px;display:inline-flex;align-items:center;gap:8px}.folio-jump:hover,.scene-links a:hover{text-decoration:underline;text-underline-offset:4px}
.folio-frame{position:relative;isolation:isolate;margin:0;background:#89978d;color:white;overflow:hidden}
.folio-image{display:block;width:100%;height:max(390px,55vw);object-fit:cover;object-position:var(--crop-x,50%) var(--crop-y,50%)}
.folio-frame::after{content:"";z-index:0;pointer-events:none;position:absolute;inset:40% 0 0;background:linear-gradient(0deg,rgba(16,25,22,.70),rgba(16,25,22,.26) 40%,transparent 96%)}
.folio-caption{position:absolute;inset:auto max(var(--gutter),env(safe-area-inset-right)) clamp(20px,3.2vw,55px) max(var(--gutter),env(safe-area-inset-left));z-index:1;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;pointer-events:none}
.folio-location{font-size:clamp(12px,1.05vw,16px);letter-spacing:.16em;margin-bottom:8px}.folio-title{font-size:clamp(42px,5.4vw,85px);font-weight:500;letter-spacing:.07em;line-height:1.08}.folio-credit{font-size:12px;letter-spacing:.09em;white-space:nowrap}
.folio-controls{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:79px;border-bottom:1px solid var(--folio-rule)}
.shot-switch,.folio-actions,.scene-links{display:flex;align-items:center}.shot-switch{gap:clamp(14px,2vw,34px)}
.shot-switch button{border:0;border-radius:0;background:transparent;position:relative;color:#57655a;font-size:14px;min-height:48px;padding:6px 2px}
.shot-switch button[aria-pressed=true]{color:#173f30;font-weight:700}.shot-switch button[aria-pressed=true]::after{content:"";position:absolute;left:2px;right:2px;bottom:5px;height:2px;background:currentColor}
.folio-actions{gap:10px;flex-wrap:wrap}.folio-actions a{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:13px;padding:7px 16px;border:1px solid var(--folio-rule);font-size:14px}
.folio-actions .enter-3d{background:#254536;color:#fffdf1;border-color:#254536}.folio-actions a:hover{box-shadow:inset 0 0 0 1px currentColor}
.scene-links{gap:14px;flex-wrap:wrap}.scene-links a{color:var(--pine)}.scene-header{row-gap:2px}.night-tools a{display:inline-flex;align-items:center;min-height:40px;background:#19221edb;color:#fffdf1;border:1px solid #d1d5bd66;padding:6px 12px;border-radius:7px;text-decoration:none;font-size:13px}
#gameplay:focus,#exterior:focus,#stage:focus,#rain:focus{outline:none}
@media(max-width:650px){.folio-head{min-height:54px}.folio-mark{transform:scale(.88);transform-origin:left center;width:21px}.folio-brand{font-size:21px}.folio-image{height:clamp(320px,58svh,550px);object-position:var(--mobile-crop,var(--crop-x,50%)) var(--crop-y,50%)}.folio-caption{gap:10px;bottom:18px}.folio-location{margin-bottom:5px}.folio-credit{font-size:10px}.folio-controls{display:grid;gap:1px;padding-bottom:14px;padding-top:3px}.shot-switch{gap:24px}.folio-actions{gap:8px}.folio-actions a{min-height:44px}.scene-links{gap:10px}.scene-links a{font-size:13px}}
</style></head><body><main>
<section id="exterior" class="exterior" tabindex="-1" aria-labelledby="exterior-title">
  <div class="folio-head"><div class="folio-id"><span class="folio-mark" aria-hidden="true"></span><span class="folio-brand">栖灵</span><span class="folio-context">校园漫游</span></div><a href="#gameplay" class="folio-jump">今日角落 <span aria-hidden="true">↓</span></a></div>
  <figure class="folio-frame">
    <img class="folio-image" id="shot-arrival" src="data:image/webp;base64,@@arrival@@" alt="从庭院望向致理楼教学楼群" style="--mobile-crop:48%;--crop-y:9%">
    <img class="folio-image" id="shot-front" src="data:image/webp;base64,@@front@@" alt="致理楼 C 座入口正面，横梁下可见立柱与折返楼梯" style="--mobile-crop:54%" hidden>
    <img class="folio-image" id="shot-shelter" src="data:image/webp;base64,@@shelter@@" alt="从致理楼檐下看柱廊与庭院" style="--mobile-crop:51%" hidden>
    <figcaption class="folio-caption"><div><p class="folio-location">深圳大学 · 粤海校区</p><h1 id="exterior-title" class="folio-title">致理楼</h1></div><span class="folio-credit">建筑场景渲染</span></figcaption>
  </figure>
  <div class="folio-controls"><div class="shot-switch" role="group" aria-label="白天建筑渲染机位">
    <button type="button" data-shot="arrival" aria-controls="shot-arrival" aria-pressed="true">庭院</button>
    <button type="button" data-shot="front" aria-controls="shot-front" aria-pressed="false">入口正面</button>
    <button type="button" data-shot="shelter" aria-controls="shot-shelter" aria-pressed="false">檐下</button>
  </div><nav class="folio-actions" aria-label="进入校园场景"><a class="enter-3d" href="#garden/arrival">从这里进入三维 <span aria-hidden="true">↗</span></a><a href="#rain">雨夜连廊 <span aria-hidden="true">↗</span></a></nav></div>
</section>
<header id="scene-header" class="scene-header" hidden><div><p class="area">栖灵 · 深圳大学粤海校区</p><h1 id="title">致理楼</h1></div><nav class="scene-links" aria-label="校园导航"><a href="#exterior">建筑外景</a><a href="#gameplay">今日角落 ↓</a></nav></header>
<section id="rain" class="night" hidden tabindex="-1" aria-label="致理楼 C 座 · 雨夜连廊"><div class="night-view" tabindex="0" aria-label="雨夜连廊全景，拖动或用方向键环看"><div class="night-cube" aria-hidden="true"></div></div><div class="night-tools"><a id="go-garden" href="#garden">庭院地图 ↗</a></div><div class="night-foot"><div><p class="night-stop" aria-live="polite">入口地垫 · 1/3</p><p class="night-hint">正在展开全景…</p></div><div class="night-steps"><button class="night-prev" disabled>往回走</button><button class="night-next">往前走</button></div></div></section>
<section id="stage" hidden aria-label="可旋转和缩放的三维校园" style="background:linear-gradient(#c4d6df,#e7e9df 53%,#d3d2c5)"><div class="map-tools"><button id="walk-in">雨夜连廊</button><button id="overview">校园全景</button><button id="entrance">C 座入口</button><button id="reset">复位</button></div><span class="hint">拖动旋转 · 双指或滚轮缩放</span><div id="loading" role="status">正在展开校园模型…</div></section>
<div class="panel" id="gameplay" tabindex="-1" role="region" aria-label="今日角落"><div class="row"><small><span id="day"></span> · <span id="mode"></span></small><span class="score" id="score"></span></div>
<div id="sites" class="options" aria-label="选择活动点"></div>
<section class="stack"><div class="row"><h2 id="spot">今天的角落</h2><button id="claim" class="primary" disabled>认领到今晚</button></div><p class="sub" id="rule"></p><p id="current"></p></section>
<fieldset id="editor" class="line stack" hidden><legend>布置角落</legend><div class="tools"><label>摆设 <select id="decor"><option value="flowers">簕杜鹃花盆</option><option value="lamp">一盏庭灯</option><option value="flag">手绘小旗</option></select></label><label>地块色 <select id="tint"><option value="jade">青玉</option><option value="apricot">杏橘</option><option value="violet">浅紫</option></select></label></div><label for="note">留给明天路过的人</label><input id="note" maxlength="40" placeholder="写一句话（选填，最多 40 字）"><div><button id="save" class="primary">摆在这里</button></div></fieldset>
<section id="quizBox" class="line stack" hidden><h3>校园问答</h3><p id="question"></p><div class="choices" id="answers"></div></section>
<section id="yesterday" hidden><div class="row"><h3>昨日印记</h3><button id="histToggle">收起摆设</button></div><p id="oldNote"></p></section>
<p id="status" role="status" aria-live="polite"></p>
<details id="study" class="line"><summary>致理楼 · 实拍对照</summary><p class="sub">从 C 座入口比一比横梁、柱位和折返楼梯。下方庭院是同一模型的傍晚灯光。</p>
<div class="study-grid"><figure><img id="campus-photo" width="2504" height="1097" alt="深圳大学心理学院公布的致理楼 C 座入口照片"><figcaption><a href="https://psy.szu.edu.cn/en/images/ba1d0f55f4c605d9ad5a93fcd850442.jpg" target="_blank" rel="noopener">深大心理学院 · 打开实拍原图 ↗</a></figcaption></figure>
<figure><img id="study-front" loading="lazy" width="1440" height="632" alt="从相近角度观察入口横梁、深灰立柱、楼梯和学院标牌的 Blender 渲染"><figcaption>栖灵 · 入口机位渲染</figcaption></figure></div>
<figure><img loading="lazy" width="1440" height="880" src="data:image/webp;base64,@@evening@@" alt="下课后的致理楼庭院，柱廊和台阶灯亮起"><figcaption>栖灵 · 下课后的庭院</figcaption></figure><p><a href="https://www.szu.edu.cn/images/my/240626campusview6.jpg" target="_blank" rel="noopener">深大校园相册 · 从台阶看玻璃厅 ↗</a></p></details>
<details id="demo" class="line" hidden><summary>试玩控制 · 两人和换日</summary><div class="stack"><p class="sub">这里使用本机示例数据。可以替另一位玩家选地，再到明天看看今天留下的东西。</p><div class="tools"><button id="steps">模拟步行 +25</button><button id="workout">模拟锻炼 +35</button><button id="swap">换位体验</button><button id="next">到明天</button></div></div></details>
<div id="liveControls" class="tools line" hidden><button id="sync">同步今日贡献</button><button id="refresh">刷新校园</button></div>
<p class="sub">每天北京时间零点重新开放领地，摆设和留言再展出一天。C 座外景参照校园实拍；雨夜连廊的陈设和灯光为游戏创作。</p>
</div></main><script type="application/octet-stream" id="rain-0">@@corridor-0@@</script><script type="application/octet-stream" id="rain-1">@@corridor-1@@</script><script type="application/octet-stream" id="rain-2">@@corridor-2@@</script><script type="application/octet-stream" id="coastalSky">@@sky@@</script><script type="application/octet-stream" id="Zhili">@@Zhili@@</script><script type="application/octet-stream" id="Yuehai">@@Yuehai@@</script><!--SCRIPT--></body></html>
